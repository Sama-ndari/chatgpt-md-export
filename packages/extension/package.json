{
  "name": "chatgpt-md-export-vscode",
  "displayName": "ChatGPT Markdown Export",
  "version": "0.5.0",
  "description": "%extension.description%",
  "publisher": "samandari",
  "author": "Samandari",
  "license": "MIT",
  "private": true,
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sama-ndari/chatgpt-md-export.git"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "chatgpt",
    "markdown",
    "export",
    "conversation",
    "ai"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Exports are written to the local file system, which a virtual workspace does not provide."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "chatgptMdExport.exportFromUrl",
        "title": "%command.exportFromUrl.title%",
        "category": "%command.category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "chatgptMdExport.exportFromArchive",
        "title": "%command.exportFromArchive.title%",
        "category": "%command.category%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "chatgptMdExport.setToken",
        "title": "%command.setToken.title%",
        "category": "%command.category%",
        "icon": "$(key)"
      },
      {
        "command": "chatgptMdExport.clearToken",
        "title": "%command.clearToken.title%",
        "category": "%command.category%",
        "icon": "$(trash)"
      },
      {
        "command": "chatgptMdExport.preview",
        "title": "%command.preview.title%",
        "category": "%command.category%",
        "icon": "$(preview)"
      },
      {
        "command": "chatgptMdExport.refresh",
        "title": "%command.refresh.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "chatgptMdExport.openExport",
        "title": "%command.openExport.title%",
        "category": "%command.category%"
      },
      {
        "command": "chatgptMdExport.openMarkdown",
        "title": "%command.openMarkdown.title%",
        "category": "%command.category%",
        "icon": "$(markdown)"
      },
      {
        "command": "chatgptMdExport.revealFolder",
        "title": "%command.revealFolder.title%",
        "category": "%command.category%",
        "icon": "$(folder)"
      },
      {
        "command": "chatgptMdExport.forgetExport",
        "title": "%command.forgetExport.title%",
        "category": "%command.category%",
        "icon": "$(close)"
      },
      {
        "command": "chatgptMdExport.openTokenHelp",
        "title": "%command.openTokenHelp.title%",
        "category": "%command.category%",
        "icon": "$(question)"
      },
      {
        "command": "chatgptMdExport.rate",
        "title": "%command.rate.title%",
        "category": "%command.category%",
        "icon": "$(star-empty)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chatgptMdExport",
          "title": "%viewsContainer.title%",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "chatgptMdExport": [
        {
          "id": "chatgptMdExport.sidebar",
          "name": "%view.sidebar.name%",
          "icon": "media/sidebar-icon.svg",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "chatgptMdExport.exportFromArchive",
          "when": "view == chatgptMdExport.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "chatgptMdExport.exportFromUrl",
          "when": "view == chatgptMdExport.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "chatgptMdExport.rate",
          "when": "view == chatgptMdExport.sidebar",
          "group": "1_misc@1"
        }
      ],
      "commandPalette": [
        {
          "command": "chatgptMdExport.openExport",
          "when": "false"
        },
        {
          "command": "chatgptMdExport.openMarkdown",
          "when": "false"
        },
        {
          "command": "chatgptMdExport.revealFolder",
          "when": "false"
        },
        {
          "command": "chatgptMdExport.forgetExport",
          "when": "false"
        },
        {
          "command": "chatgptMdExport.refresh",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "chatgptMdExport.outputDirectory": {
          "type": "string",
          "default": "chatgpt-exports",
          "description": "%configuration.outputDirectory.description%"
        },
        "chatgptMdExport.authorName": {
          "type": "string",
          "default": "",
          "description": "%configuration.authorName.description%"
        },
        "chatgptMdExport.downloadAttachments": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.downloadAttachments.description%"
        },
        "chatgptMdExport.accountId": {
          "type": "string",
          "default": "",
          "description": "%configuration.accountId.description%"
        },
        "chatgptMdExport.openAfterExport": {
          "type": "string",
          "enum": [
            "markdown",
            "preview",
            "none"
          ],
          "default": "preview",
          "description": "%configuration.openAfterExport.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -b && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@chatgpt-md-export/core": "0.2.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0"
  },
  "l10n": "./l10n",
  "qna": false,
  "galleryBanner": {
    "color": "#14212b",
    "theme": "dark"
  },
  "bugs": {
    "url": "https://github.com/Sama-ndari/chatgpt-md-export/issues"
  },
  "homepage": "https://github.com/Sama-ndari/chatgpt-md-export#readme"
}
